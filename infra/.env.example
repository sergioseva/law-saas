# Local-dev environment for docker-compose. Copy to infra/.env.

# Django
SECRET_KEY=dev-secret-not-for-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,.lvh.me
DJANGO_SETTINGS_MODULE=lawsaas.settings.dev

# Postgres
POSTGRES_DB=lawsaas
POSTGRES_USER=lawsaas
POSTGRES_PASSWORD=lawsaas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CACHE_REDIS_URL=redis://redis:6379/3

# Encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEK=changeme-generate-a-real-key-for-local-dev

# Frontend (forwarded to Next.js when run inside compose, optional)
NEXT_PUBLIC_API_BASE=http://api.lvh.me:8000

# Email (Resend) — leave blank locally, mailcatcher could be added later
RESEND_API_KEY=

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lawsaas-dev
R2_ENDPOINT=

# Sentry
SENTRY_DSN_API=
SENTRY_DSN_WEB=

# Caddy auto-issues a wildcard cert for *.lawsaas.app via Cloudflare DNS-01.
# Requires the caddy-dns/cloudflare module — built into the image with the
# `caddy:2` build below or via the official caddy-builder. If using plain
# caddy:2, replace this image with one that has the Cloudflare DNS module.

{
	email admin@lawsaas.app
}

# Per-firm subdomains and api subdomain — all proxied to Django.
*.lawsaas.app, api.lawsaas.app {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	# Strip /api prefix isn't needed — Django routes by Host header.
	reverse_proxy api:8000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}

# Marketing / signup site is served by Vercel — point app.lawsaas.app at Vercel
# directly via DNS, not via this Caddy. (No vhost block needed here.)
